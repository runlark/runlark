{
  "schema_version": 1,
  "workflow_id": "solo-default",
  "stages": ["clarify", "plan", "implement", "validate", "human-accept"],
  "transitions": [
    {
      "from_stage": "clarify",
      "to_stage": "plan",
      "max_attempts": 3
    },
    {
      "from_stage": "plan",
      "to_stage": "implement",
      "max_attempts": 2
    },
    {
      "from_stage": "implement",
      "to_stage": "validate",
      "max_attempts": 5
    },
    {
      "from_stage": "validate",
      "to_stage": "implement",
      "max_attempts": 3
    },
    {
      "from_stage": "validate",
      "to_stage": "human-accept",
      "max_attempts": 1
    }
  ],
  "validator_stage": "validate",
  "budget": {
    "max_repair_attempts": 3,
    "max_wall_seconds": 1800,
    "max_spend_cents": 500,
    "human_acceptance_required": true
  }
}
