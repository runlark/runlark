{
  "name": "runlark-tooling",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "format:check": "oxfmt --check .",
    "format": "oxfmt --write .",
    "lint:markdown": "markdownlint-cli2",
    "audit": "npm audit --audit-level=low"
  },
  "devDependencies": {
    "markdownlint-cli2": "0.24.1",
    "oxfmt": "0.78.0"
  },
  "overrides": {
    "micromark-extension-math": {
      "katex": "0.19.1"
    },
    "markdownlint": {
      "re2js": "2.8.7"
    }
  }
}
